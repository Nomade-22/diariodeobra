# Banco PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth
# Gere uma chave longa e aleatória para produção.
BETTER_AUTH_SECRET=troque-por-uma-chave-segura

# Na Vercel, BETTER_AUTH_URL e BETTER_AUTH_TRUSTED_ORIGINS são opcionais:
# a aplicação reconhece automaticamente VERCEL_URL, VERCEL_BRANCH_URL e
# VERCEL_PROJECT_PRODUCTION_URL.
# BETTER_AUTH_URL=http://localhost:4000
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4000

# Vercel Blob
# Estas variáveis são injetadas automaticamente quando um Blob Store
# é conectado ao projeto na Vercel.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=

# Integrações opcionais
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=


# Integração servidor a servidor com o Dashboard Multprest
DASHBOARD_API_URL=https://dashboard-multprest.vercel.app/api/public/diary-entries
# Opcional: use o mesmo valor configurado no Dashboard para proteger a API.
DASHBOARD_SYNC_TOKEN=
